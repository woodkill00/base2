      "command": ["npm", "--prefix", "react-app", "run", "lint"],
      "required": true,
      "timeoutSeconds": 180,
      "dependsOn": ["env-tools"],
      "requiredTools": ["node", "npm"]
    },
    {
      "id": "frontend-test",
      "command": ["npm", "--prefix", "react-app", "run", "test:ci"],
      "required": true,
      "timeoutSeconds": 900,
      "dependsOn": ["frontend-lint"],
      "requiredTools": ["node", "npm"]
    },
    {
      "id": "frontend-build",
      "command": ["npm", "--prefix", "react-app", "run", "build"],
      "required": true,
      "timeoutSeconds": 600,
      "dependsOn": ["frontend-test"],
      "requiredTools": ["node", "npm"]
    },
    {
      "id": "api-tests",
      "command": [
        "{python-api}",
        "-m",
        "pytest",
        "api/tests",
        "-c",
        "api/pytest.ini",
        "-m",
        "not integration and not perf",
        "--cov-report=json:.artifacts/coverage/api.json"
      ],
      "required": true,
      "timeoutSeconds": 900,
      "dependsOn": ["env-tools"],
      "requiredTools": ["{python-api}"]
    },
    {
      "id": "django-tests",
      "command": [
        "{python-django}",
        "-m",
        "pytest",
        "django/tests",
        "-c",
        "django/pytest.ini",
        "-m",
        "not integration and not perf",
        "--cov=project",
        "--cov=users",
        "--cov=common",
        "--cov=catalog",
        "--cov=api_schema",
        "--cov-report=json:.artifacts/coverage/django.json"
      ],
      "required": true,
      "timeoutSeconds": 900,
      "dependsOn": ["env-tools"],
      "requiredTools": ["{python-django}"]
    },
    {
      "id": "digitalocean-tests",
      "command": [
        "{python-orchestrator}",
        "-m",
        "pytest",
        "digital_ocean/tests",
        "--cov=digital_ocean/scripts/python",
        "--cov-report=json:.artifacts/coverage/digitalocean.json"
      ],
      "required": true,
      "timeoutSeconds": 300,
      "dependsOn": ["env-tools"],
      "requiredTools": ["{python-orchestrator}"]
    },
    {
      "id": "coverage-policy",
      "command": ["python3", "scripts/python/run_coverage_policy.py"],
      "required": true,
      "timeoutSeconds": 60,
      "dependsOn": [
        "env-tools",
        "frontend-test",
        "api-tests",
        "django-tests",
        "digitalocean-tests"
      ],
      "requiredTools": ["python3"]
    },
    {
      "id": "frontend-production-audit",
      "command": ["npm", "--prefix", "react-app", "audit", "--omit=dev", "--audit-level=high"],
      "required": true,
      "timeoutSeconds": 180,
      "dependsOn": ["frontend-build"],
      "requiredTools": ["npm"]
    },
    {
      "id": "compose-config",
      "command": ["python3", "scripts/python/validate_compose_config.py"],
      "required": true,
      "timeoutSeconds": 60,
      "dependsOn": ["env-tools"],
      "requiredTools": ["docker", "python3"]
