{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "feature-093-plan",
      "command": ["python3", "scripts/python/validate_feature_093.py"],
      "required": true,
      "timeoutSeconds": 30,
      "dependsOn": [],
      "requiredTools": ["python3"]
    },
    {
      "id": "shell-parity",
      "command": ["node", "scripts/guard-shell-parity.js"],
      "required": true,
      "timeoutSeconds": 30,
      "dependsOn": [],
      "requiredTools": ["node"]
    },
    {
      "id": "command-matrix",
      "command": ["node", "scripts/validate-command-matrix.js"],
      "required": true,
      "timeoutSeconds": 30,
      "dependsOn": ["shell-parity"],
      "requiredTools": ["node"]
    },
    {
      "id": "ci-policy",
      "command": ["python3", "scripts/python/validate_ci_policy.py"],
      "required": true,
      "timeoutSeconds": 30,
      "dependsOn": ["shell-parity"],
      "requiredTools": ["python3"]
    },
    {
      "id": "dependency-policy",
      "command": ["python3", "scripts/python/validate_dependency_policy.py"],
      "required": true,
      "timeoutSeconds": 30,
      "dependsOn": ["ci-policy"],
      "requiredTools": ["python3"]
    },
    {
      "id": "env-tools",
      "command": ["node", "scripts/run-root-coverage.js"],
      "required": true,
      "timeoutSeconds": 120,
      "dependsOn": ["shell-parity"],
      "requiredTools": ["node", "npm"]
    },
    {
      "id": "frontend-lint",
      "command": ["npm", "--prefix", "react-app", "run", "lint"],
      "required": true,
      "timeoutSeconds": 180,
      "dependsOn": ["env-tools"],
      "requiredTools": ["node", "npm"]
    },
    {
      "id": "frontend-test",
      "command": ["npm", "--prefix", "react-app", "run", "test:ci"],
      "required": true,
      "timeoutSeconds": 900,
      "dependsOn": ["frontend-lint"],
      "requiredTools": ["node", "npm"]
    },
    {
      "id": "frontend-build",
      "command": ["npm", "--prefix", "react-app", "run", "build"],
      "required": true,
      "timeoutSeconds": 600,
      "dependsOn": ["frontend-test"],
      "requiredTools": ["node", "npm"]
    },
    {
      "id": "api-tests",
      "command": [
        "{python-api}",
        "-m",
        "pytest",
        "api/tests",
        "-c",
        "api/pytest.ini",
        "-m",
        "not integration and not perf",
        "--cov-report=json:.artifacts/coverage/api.json"
      ],
      "required": true,
      "timeoutSeconds": 900,
      "dependsOn": ["env-tools"],
      "requiredTools": ["{python-api}"]
    },
    {
      "id": "django-tests",
      "command": [
        "{python-django}",
        "-m",
        "pytest",
        "django/tests",
        "-c",
        "django/pytest.ini",
        "-m",
        "not integration and not perf",
        "--cov=project",
        "--cov=users",
        "--cov=common",
        "--cov=catalog",
        "--cov=api_schema",
        "--cov-report=json:.artifacts/coverage/django.json"
      ],
      "required": true,
      "timeoutSeconds": 900,
      "dependsOn": ["env-tools"],
      "requiredTools": ["{python-django}"]
    },
    {
      "id": "digitalocean-tests",
      "command": [
        "{python-orchestrator}",
        "-m",
        "pytest",
        "digital_ocean/tests",
        "--cov=digital_ocean/scripts/python",
        "--cov-report=json:.artifacts/coverage/digitalocean.json"
      ],
      "required": true,
      "timeoutSeconds": 300,
      "dependsOn": ["env-tools"],
      "requiredTools": ["{python-orchestrator}"]
    },
    {
      "id": "coverage-policy",
      "command": ["python3", "scripts/python/run_coverage_policy.py"],
      "required": true,
      "timeoutSeconds": 60,
      "dependsOn": [
        "env-tools",
        "frontend-test",
        "api-tests",
        "django-tests",
        "digitalocean-tests"
      ],
      "requiredTools": ["python3"]
    },
    {
      "id": "frontend-production-audit",
      "command": ["npm", "--prefix", "react-app", "audit", "--omit=dev", "--audit-level=high"],
      "required": true,
      "timeoutSeconds": 180,
      "dependsOn": ["frontend-build"],
      "requiredTools": ["npm"]
    },
    {
      "id": "compose-config",
      "command": ["python3", "scripts/python/validate_compose_config.py"],
      "required": true,
      "timeoutSeconds": 60,
      "dependsOn": ["env-tools"],
      "requiredTools": ["docker", "python3"]
    }
  ]
}
