{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://base2.invalid/schemas/full-preview-policy-v1.json",
  "title": "Base2 Full Preview Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "profileId",
    "certificateMode",
    "ownerCidrs",
    "ttlMinutes",
    "routes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "const": "full-preview" },
    "profileId": { "const": "base2-obsidian" },
    "certificateMode": { "const": "letsencrypt-staging-only" },
    "ownerCidrs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 49 }
    },
    "ttlMinutes": { "type": "integer", "minimum": 15, "maximum": 240 },
    "routes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "path", "service", "exposure"],
        "properties": {
          "host": { "type": "string" },
          "path": { "type": "string", "pattern": "^/" },
          "service": { "type": "string" },
          "exposure": { "enum": ["public", "protected-edge", "internal"] }
        }
      }
    }
  }
}
