{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://base2.local/contracts/module-manifest-v1.schema.json",
  "title": "Base2 Module Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "compatibility", "models", "migrations", "apiRoutes", "uiRoutes", "navigation", "permissions", "jobs", "settingsSchema", "healthChecks", "providerCapabilities", "dependencies", "dataLifecycle"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "compatibility": {"type": "string", "minLength": 1},
    "models": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "migrations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "apiRoutes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
    "uiRoutes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
    "navigation": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "jobs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "settingsSchema": {"type": "string", "minLength": 1},
    "healthChecks": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "providerCapabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["network", "email", "storage", "payment", "analytics", "publish"]}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "dataLifecycle": {"type": "object", "additionalProperties": false, "required": ["disable", "export", "remove"], "properties": {"disable": {"enum": ["preserve", "archive"]}, "export": {"type": "boolean"}, "remove": {"enum": ["forbid", "backup-required", "purge"]}}}
  }
}
