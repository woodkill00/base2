{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://base2.invalid/contracts/factory-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "modules",
    "owner",
    "license",
    "secretRefs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "name": { "type": "string", "minLength": 3, "maxLength": 120 },
    "description": { "type": "string", "minLength": 10, "maxLength": 500 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" }
    },
    "owner": { "type": "string", "pattern": "^@[A-Za-z0-9][A-Za-z0-9_-]{1,38}$" },
    "license": { "enum": ["UNLICENSED", "MIT", "Apache-2.0"] },
    "secretRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^vaultwarden://[A-Za-z0-9][A-Za-z0-9._/-]{2,254}$" }
    }
  }
}
