{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatorVersion",
    "baseCommit",
    "baseTree",
    "profileId",
    "profileDigest",
    "childId",
    "moduleInventory",
    "transformations",
    "sourceMode"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "const": "1.0.0" },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "baseTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "profileId": { "type": "string" },
    "profileDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "childId": { "type": "string" },
    "moduleInventory": { "type": "array", "items": { "type": "string" } },
    "transformations": { "type": "array", "items": { "type": "string" } },
    "sourceMode": { "const": "git-archive-exact-commit" }
  }
}
