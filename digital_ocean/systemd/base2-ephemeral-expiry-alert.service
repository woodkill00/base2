[Unit]
Description=Observe and persist verified Base2 ephemeral expiry failures
ConditionPathIsDirectory=/opt/base2/current
ConditionPathIsExecutable=/usr/bin/python3

[Service]
Type=oneshot
User=base2-preview
Group=base2-preview
EnvironmentFile=/etc/base2/ephemeral-expiry.env
WorkingDirectory=/opt/base2/current
ExecStart=/usr/bin/flock --exclusive /var/lib/base2/ephemeral-expiry/.alert.lock /usr/bin/python3 /opt/base2/current/scripts/python/ephemeral_expiry.py --root /var/lib/base2/ephemeral-expiry --key-file ${BASE2_EPHEMERAL_EXPIRY_KEY_FILE} --observe-failures
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/base2/ephemeral-expiry
UMask=0077
