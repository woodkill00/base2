FROM mirror.gcr.io/library/python@sha256:0f5b26b9518d002b6173fd61daad821fa340635ebfec5bba471013f9ca114579
WORKDIR /app
RUN printf '%s\n' \
      'Types: deb' \
      'URIs: https://snapshot.debian.org/archive/debian/20260824T000000Z' \
      'Suites: bookworm bookworm-updates' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      '' \
      'Types: deb' \
      'URIs: https://snapshot.debian.org/archive/debian-security/20260824T000000Z' \
      'Suites: bookworm-security' \
      'Components: main' \
      'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
      ca-certificates=20250419~deb12u1 \
      clamav=1.4.3+dfsg-1~deb12u2 \
      ffmpeg=7:5.1.9-0+deb12u1 \
      util-linux=2.38.1-5+deb12u3 \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 1000 --create-home inspector \
    && mkdir -p /var/lib/base2/media-inspector \
    && chown -R inspector:inspector /app /var/lib/base2/media-inspector
COPY --chown=inspector:inspector requirements-media-inspector.txt ./api/requirements-media-inspector.txt
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/vendor:/app
USER inspector
RUN pip install --no-cache-dir --only-binary=:all: --no-deps --require-hashes \
      --target /app/vendor \
      -r api/requirements-media-inspector.txt
COPY --chown=inspector:inspector . ./api
USER root
CMD ["python", "-m", "api.services.media_inspector_service"]
