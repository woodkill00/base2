#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Running compact risk-based assurance before push..."

if scripts/bash/assure.sh run --tier auto --json; then
  echo "✅ Assurance passed! Proceeding with push..."
else
  echo "❌ Assurance failed! Push aborted."
  echo "Inspect the private evidence path reported above."
  exit 1
fi
