{
  "name": "app-react-app",
  "version": "1.0.0",
  "description": "React application",
  "private": true,
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@react-oauth/google": "^0.12.1",
    "axios": "^1.6.0",
    "framer-motion": "^11.18.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.26.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@playwright/test": "^1.47.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@storybook/addon-essentials": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.41.0",
    "autoprefixer": "^10.4.23",
    "cross-env": "^7.0.3",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.6.6",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "storybook": "^8.6.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "yaml": "^2.8.2"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "node --max-old-space-size=4096 --no-concurrent-recompilation --no-concurrent-marking node_modules/vitest/vitest.mjs run --coverage --pool=threads --maxWorkers=1",
    "test:watch": "node --max-old-space-size=4096 --no-concurrent-recompilation --no-concurrent-marking node_modules/vitest/vitest.mjs",
    "test:ci": "cross-env CI=true node --max-old-space-size=4096 --no-concurrent-recompilation --no-concurrent-marking node_modules/vitest/vitest.mjs run --coverage --pool=threads --maxWorkers=1",
    "test:public-contract": "node --no-concurrent-recompilation --no-concurrent-marking node_modules/vitest/vitest.mjs run src/__tests__/public-experience-contract.test.jsx src/__tests__/site-content-api.test.js --coverage=false --pool=threads --maxWorkers=1",
    "test:privacy-contract": "node --no-concurrent-recompilation --no-concurrent-marking node_modules/vitest/vitest.mjs run src/__tests__/consent-localization.test.jsx --coverage=false",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\"",
    "e2e": "playwright test --reporter=list",
    "e2e:headed": "playwright test --headed",
    "test:visual": "playwright test --config=playwright.visual.config.mjs",
    "test:visual-release": "playwright test --config=playwright.visual-release.config.mjs",
    "test:live-full-preview": "playwright test --config=playwright.live-full-preview.config.mjs",
    "test:live-edge-auth": "node --test e2e/live/owner-edge-auth.test.mjs",
    "test:account-e2e": "playwright test --config=playwright.account.config.mjs",
    "test:settings-release": "playwright test --config=playwright.settings-release.config.mjs",
    "test:workspace-release": "playwright test --config=playwright.workspace-release.config.mjs",
    "test:compatibility": "playwright test --config=playwright.compatibility.config.mjs",
    "e2e:install": "playwright install",
    "analyze": "vite build --mode analyze",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:openapi:types": "openapi-typescript ../specs/001-django-fastapi-react/contracts/openapi.yaml -o src/services/api/types.d.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
