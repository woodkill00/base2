{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "allowedTypes",
    "maximumObjectBytes",
    "maximumBatchFiles",
    "maximumBatchBytes",
    "maximumConcurrentProcessing",
    "uploadSessionMinutes",
    "deliveryGrantMinutes",
    "scannerMaximumAgeHours",
    "storageAdapter",
    "scannerAdapter"
  ],
  "properties": {
    "enabled": { "type": "boolean", "default": false },
    "allowedTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "image/jpeg",
          "image/png",
          "image/webp",
          "application/pdf",
          "audio/mpeg",
          "audio/ogg",
          "video/mp4",
          "video/webm"
        ]
      }
    },
    "maximumObjectBytes": { "type": "integer", "minimum": 1, "maximum": 104857600 },
    "maximumBatchFiles": { "type": "integer", "minimum": 1, "maximum": 100 },
    "maximumBatchBytes": { "type": "integer", "minimum": 1, "maximum": 524288000 },
    "maximumConcurrentProcessing": { "type": "integer", "minimum": 1, "maximum": 16 },
    "uploadSessionMinutes": { "type": "integer", "minimum": 5, "maximum": 120 },
    "deliveryGrantMinutes": { "type": "integer", "minimum": 1, "maximum": 15 },
    "scannerMaximumAgeHours": { "type": "integer", "minimum": 1, "maximum": 72 },
    "storageAdapter": { "type": "string", "enum": ["local-private", "s3-compatible"] },
    "scannerAdapter": { "type": "string", "enum": ["clamav"] }
  }
}
