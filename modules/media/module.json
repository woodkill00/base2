{
  "schemaVersion": 1,
  "id": "media",
  "version": "2.1.0",
  "compatibility": ">=2.0.0,<3.0.0",
  "models": [
    "media.asset",
    "media.object-version",
    "media.variant",
    "media.upload-session",
    "media.upload-part",
    "media.inspection-result",
    "media.derivative-recipe",
    "media.metadata-revision",
    "media.collection",
    "media.reference",
    "media.delivery-grant",
    "media.export-package",
    "media.audit-event",
    "media.outbox-event",
    "media.encryption-envelope",
    "media.abuse-case",
    "media.job",
    "media.retention-hold",
    "media.purge-plan"
  ],
  "migrations": [
    "django/sitecontent/migrations/0011_universal_media_library.py",
    "django/sitecontent/migrations/0012_universal_media_library_roles.py",
    "django/sitecontent/migrations/0013_media_governance.py",
    "django/sitecontent/migrations/0014_media_processing_governance.py",
    "django/sitecontent/migrations/0015_media_portability_and_abuse.py"
  ],
  "apiRoutes": ["/api/media/v1"],
  "uiRoutes": ["/media"],
  "navigation": ["media.library"],
  "permissions": [
    "media.read",
    "media.upload",
    "media.write",
    "media.publish",
    "media.archive",
    "media.delete",
    "media.audit",
    "media.policy"
  ],
  "jobs": [
    "media.inspect",
    "media.derive",
    "media.reconcile",
    "media.export",
    "media.expire",
    "media.purge"
  ],
  "settingsSchema": "modules/media/settings.schema.json",
  "healthChecks": ["media.storage-ready", "media.scanner-ready", "media.worker-ready"],
  "providerCapabilities": ["storage"],
  "dependencies": ["content-workspace"],
  "dataLifecycle": { "disable": "preserve", "export": true, "remove": "backup-required" }
}
