{
  "schemaVersion": 1,
  "performanceBudgets": {
    "lcpMilliseconds": 2500,
    "inpMilliseconds": 200,
    "cls": 0.1,
    "frontendKilobytes": 750,
    "apiP95Milliseconds": 500,
    "queriesPerRequest": 30,
    "poolUtilizationPercent": 80,
    "workerLagSeconds": 60,
    "cpuPercent": 80,
    "memoryPercent": 80,
    "storagePercent": 80,
    "telemetryCpuPercent": 5
  },
  "loadModels": ["small", "medium", "large"],
  "actors": ["public", "member", "editor", "operator", "background"],
