[
  {
    "class": "database-role",
    "owner": "operator",
    "scope": "environment-tenant-runtime",
    "source": "vaultwarden-ref",
    "consumer": "application-runtime",
    "lifetimeSeconds": 86400,
    "rotation": "overlap-then-promote",
    "revocation": "generation-disable",
    "recovery": "owner-renewal"
  },
  {
    "class": "provider-api",
    "owner": "operator",
    "scope": "release-adapter-only",
    "source": "vaultwarden-ref",
    "consumer": "release-adapter",
    "lifetimeSeconds": 3600,
    "rotation": "overlap-then-promote",
    "revocation": "provider-disable",
    "recovery": "owner-renewal"
  },
  {
    "class": "delivery-api",
    "owner": "operator",
    "scope": "notification-adapter-only",
    "source": "vaultwarden-ref",
    "consumer": "delivery-adapter",
    "lifetimeSeconds": 3600,
    "rotation": "overlap-then-promote",
    "revocation": "provider-disable",
    "recovery": "owner-renewal"
  },
  {
    "class": "integrity-key",
    "owner": "operator",
    "scope": "single-evidence-family",
    "source": "vaultwarden-ref",
    "consumer": "evidence-writer",
    "lifetimeSeconds": 2592000,
    "rotation": "generation-window",
    "revocation": "generation-disable",
    "recovery": "owner-renewal"
  }
]
