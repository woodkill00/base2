{
  "schemaVersion": 1,
  "probes": [
    { "id": "public.root", "kind": "http", "freshnessSeconds": 300, "timeoutSeconds": 10 },
    { "id": "api.health", "kind": "http", "freshnessSeconds": 180, "timeoutSeconds": 10 },
    { "id": "database.ready", "kind": "database", "freshnessSeconds": 180, "timeoutSeconds": 5 },
    { "id": "workers.ready", "kind": "worker", "freshnessSeconds": 180, "timeoutSeconds": 5 },
    { "id": "queues.delay", "kind": "queue", "freshnessSeconds": 180, "timeoutSeconds": 5 },
    {
      "id": "objects.ready",
      "kind": "object-storage",
      "freshnessSeconds": 300,
      "timeoutSeconds": 10
    },
    { "id": "dns.canonical", "kind": "dns", "freshnessSeconds": 900, "timeoutSeconds": 10 },
    {
      "id": "certificate.expiry",
      "kind": "certificate",
      "freshnessSeconds": 3600,
      "timeoutSeconds": 10
    },
    { "id": "email.delivery", "kind": "email", "freshnessSeconds": 900, "timeoutSeconds": 10 },
    {
      "id": "schedules.freshness",
      "kind": "schedule",
      "freshnessSeconds": 300,
      "timeoutSeconds": 5
    },
    { "id": "capacity.headroom", "kind": "capacity", "freshnessSeconds": 180, "timeoutSeconds": 5 },
    { "id": "monitoring.self", "kind": "monitor", "freshnessSeconds": 180, "timeoutSeconds": 5 }
  ],
  "collection": { "maximumProbes": 32, "maximumBatchSeconds": 60, "maximumDimensions": 16 },
  "retention": { "healthDays": 30, "syntheticDays": 30, "incidentDays": 365 }
}
