{
  "schemaVersion": 1,
  "enabledByDefault": false,
  "documentFields": [
    "id",
    "tenantId",
    "kind",
    "title",
    "body",
    "urlPath",
    "permissions",
    "facets",
    "sourceUpdatedAt",
