{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://base2.invalid/schemas/security-result-v1.schema.json",
  "title": "Base2 normalized security result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "family",
    "tool",
    "sourceCommit",
    "rawArtifactSha256",
    "status",
    "counts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "family": {
      "enum": ["secret", "sast", "dependency", "sbom", "provenance", "image", "dast", "iac"]
    },
    "tool": { "type": "string", "minLength": 1, "maxLength": 80 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rawArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["passed", "failed"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "moderate", "low", "unknown", "total"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "moderate": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
